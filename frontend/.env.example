# Backend admin API base URL. In dev, keep this as "/admin" to use the Vite dev proxy
# (see VITE_DEV_BACKEND_URL below). In production, point it at the deployed backend,
# e.g. https://api.example.com/admin
VITE_API_BASE_URL=/admin

# Dev-only: where the Vite dev server proxies "/admin" requests to. Not used in production
# builds (VITE_API_BASE_URL is used directly there instead).
VITE_DEV_BACKEND_URL=http://localhost:8000
