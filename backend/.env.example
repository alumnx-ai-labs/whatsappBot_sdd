# Local SQLite database file (created automatically by Alembic migrations)
DATABASE_URL=sqlite:///./data/app.db

# Server
PORT=8000
ENVIRONMENT=development

# Admin auth
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_MINUTES=60

# Conversation
PROPOSAL_EXPIRY_MINUTES=30
DEFAULT_PHONE_COUNTRY=IN
BUSINESS_TIMEZONE=UTC
SUPPORTED_LOCATIONS=

# LLM provider (LangChain agent) - do not commit real values
GOOGLE_API_KEY=
LLM_PROVIDER_API_KEY=
LLM_MODEL=gpt-4o-mini

# Hello Oscar integration - NEEDS CLARIFICATION (see research.md item 9); placeholders only
HELLO_OSCAR_BASE_URL=
HELLO_OSCAR_API_KEY=
HELLO_OSCAR_TIMEOUT_MS=8000

# CSV limits
CSV_MAX_FILE_BYTES=5242880
CSV_MAX_ROWS=5000
